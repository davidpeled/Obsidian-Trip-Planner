{
  "name": "obsidian-trip-planner",
  "version": "0.1.0",
  "description": "Obsidian plugin: create a structured folder per trip (flights, transportation, a note per day) and open any trip from a dashboard.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && vitest run && node esbuild.config.mjs production",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 0",
    "deploy": "node scripts/install-vault.mjs",
    "link:vault": "node scripts/install-vault.mjs --link",
    "test:coverage": "vitest run --coverage",
    "check:licenses": "node scripts/check-licenses.mjs"
  },
  "keywords": [
    "obsidian",
    "travel",
    "trip",
    "planner"
  ],
  "author": "David Peled",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@vitest/coverage-v8": "^2.1.9",
    "esbuild": "^0.24.0",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.5.1",
    "globals": "^16.5.0",
    "happy-dom": "^15.11.7",
    "obsidian": "1.14.4",
    "tslib": "^2.6.2",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.72.1",
    "vitest": "^2.1.9"
  }
}
